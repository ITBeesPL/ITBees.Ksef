<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>ITBees.Ksef.Credentials</PackageId>
    <Version>8.0.7</Version>
    <Authors>ITBees</Authors>
    <Description>Per-company KSeF credential store: encrypted token or PKCS#12 certificate kept in the host database, REST endpoints for managing it and a connection test. Turns the single-tenant ITBees.Ksef client into a multi-tenant integration.</Description>
    <PackageTags>ksef;e-invoicing;multi-tenant;credentials;faktura;poland</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ITBees.Ksef\ITBees.Ksef.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ITBees.Interfaces" Version="8.0.72" />
    <PackageReference Include="ITBees.RestfulApiControllers" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
